# ==============================================================================
# AdVantage OS — Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# ==============================================================================

# ── Application Settings ───────────────────────────────────────────────────────
APP_ENV=development
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection string for regular queries and migrations
DATABASE_URL=postgresql://<user>:<password>@<ep-pooler-domain>/<dbname>?channel_binding=require&sslmode=require

# Direct unpooled connection string
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<ep-domain>/<dbname>?channel_binding=require&sslmode=require

# Neon API & Branch configuration
NEON_API_KEY=napi_your_neon_api_key_here
NEON_BRANCH=production

# ── AI Services & LLMs ────────────────────────────────────────────────────────
# Cohere API for SME trend analysis & keyword expansions
COHERE_API_KEY=your_cohere_api_key_here

# Groq API for ultra-fast LLaMA prompt synthesis & creative captions
GROQ_API_KEY=gsk_your_groq_api_key_here

# NVIDIA API Catalog for Flux / SDXL image generation
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here

# Pollinations AI fallback key (Optional)
POLLINATIONS_API_KEY=sk_your_pollinations_key_here

# HuggingFace token for sentiment models and caption fallback
HF_TOKEN=hf_your_huggingface_token_here

# ── Social & Web Scraping ─────────────────────────────────────────────────────
# ScrapeBadger / BrightData / Proxy service key
SCRAPEBADGER_API_KEY=sb_your_scrapebadger_key_here

# Twitter / X API Key
TWITTER_API_KEY=your_twitter_api_key_here

# YouTube Data API Key
YOUTUBE_API_KEY=AIzaSy_your_youtube_api_key_here

# ── Cloud Object Storage (S3 / Neon Storage) ──────────────────────────────────
AWS_ENDPOINT_URL_S3=https://<your-bucket-endpoint>.storage.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_your_access_key_here
AWS_SECRET_ACCESS_KEY=nsk_your_secret_key_here
AWS_REGION=us-east-2
