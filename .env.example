# REQUIRED - free key from https://build.nvidia.com/settings/api-keys (starts with nvapi-)
NVIDIA_API_KEY=nvapi-paste-your-key-here

# RECOMMENDED - free key from https://console.groq.com/keys (starts with gsk_), no credit card.
# Used first for captions: fast, and independent of NVIDIA's busy shared queue.
GROQ_API_KEY=

# OPTIONAL - free key from https://enter.pollinations.ai . Improves the backup image provider
# that is used only when both NVIDIA image models fail. Works without it (slower/throttled).
POLLINATIONS_API_KEY=

# --- Advanced overrides: leave these out unless you need them ---
# NVIDIA_IMAGE_MODELS=black-forest-labs/flux.1-dev,black-forest-labs/flux.1-schnell
# NVIDIA_CHAT_MODELS=qwen/qwen3-next-80b-a3b-instruct,meta/llama-3.2-3b-instruct
# GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
# POLLINATIONS_FALLBACK=1
# NVIDIA_IMG2IMG_MODE=auto
